---
import type { Field } from '../rl/sim';
interface Props { unlocked: string[] }
const { unlocked } = Astro.props;
const all = Object.values(import.meta.glob<Field>('../../fields/*.json', { eager: true, import: 'default' }));
const open = all.filter((f) => f.default || unlocked.includes(f.name));
const locked = all.filter((f) => !open.includes(f));
---
<section class="rl" data-fields={JSON.stringify(open)}>
  <div class="stage">
    <canvas class="rain"></canvas>
    <div class="label">
      <b>かわりんの学習フィールド</b>
      <span>8本のレイで周囲を見て、進化戦略でオーブを速く多く集めるよう学習中</span>
    </div>
  </div>
  <div class="bottom">
    <div class="hud">
      <span class="hud-text"></span>
      <canvas class="spark" width="240" height="36"></canvas>
    </div>
    <div class="ctrl">
      {open.map((f) => <button data-field={f.name}>{f.title}</button>)}
      {locked.map(() => <button disabled title="論文を読了すると解放">🔒 ？？？</button>)}
      <label>学習
        <select class="budget">
          <option value="2">ゆっくり</option>
          <option value="6" selected>通常</option>
          <option value="14">全力</option>
        </select>
      </label>
      <button class="reset">学習リセット</button>
    </div>
  </div>
</section>
<script>
  import { mount } from '../rl/main';
  document.querySelectorAll<HTMLElement>('.rl').forEach(mount);
</script>
<style>
  .rl { --rl-ink: #a9d8b6; --rl-dim: #4f7a5d; --rl-line: #17301f; background: #020604; color: var(--rl-ink); border: 1px solid var(--rl-line); border-radius: 10px; overflow: hidden; font-family: var(--mono); }
  .stage { position: relative; height: clamp(300px, 52vw, 480px); }
  .stage :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  canvas.rain { opacity: .7; pointer-events: none; }
  .label { position: absolute; left: 14px; top: 10px; z-index: 1; pointer-events: none; font-size: .8rem; display: flex; flex-direction: column; text-shadow: 0 0 6px #020604; }
  .label span { color: var(--rl-dim); }
  .bottom { border-top: 1px solid var(--rl-line); padding: 10px 14px; }
  .hud { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; font-size: .8rem; }
  canvas.spark { width: 240px; max-width: 100%; height: 36px; }
  .ctrl { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 8px; font-size: .8rem; color: var(--rl-dim); }
  button, select { font: inherit; background: transparent; color: var(--rl-ink); border: 1px solid var(--rl-line); border-radius: 4px; padding: 2px 10px; cursor: pointer; }
  select option { background: #020604; }
  button.on { border-color: var(--rl-ink); }
  button:disabled { opacity: .4; cursor: default; }
</style>

---
import Base from '../layouts/Base.astro';
import ActivityCurve from '../components/ActivityCurve.astro';
import World from '../components/World.astro';
import NoteCard from '../components/NoteCard.astro';
import { getPapers, getExperiments, progress, notes, activities, getExtras, url } from '../lib';
const papers = await getPapers();
const exps = await getExperiments();
const done = papers.filter((p) => p.data.status === 'done');
const reading = papers.filter((p) => p.data.status === 'reading');
const extras = await getExtras();
const acts = activities(papers, exps, extras);
const trying = extras.tr.filter((t) => t.data.status === 'doing');
const since = (days: number) => acts.filter((a) => +a.date > Date.now() - days * 864e5).length;
const stats = [
  { label: '読了した論文', value: done.length, unit: '本' },
  { label: '書いた考察', value: notes(papers).length, unit: '本' },
  { label: '実験ログ', value: exps.length, unit: '件' },
  { label: '直近30日の活動', value: since(30), unit: '件' },
];
const fmt = (d: Date) => d.toISOString().slice(5, 10).replace('-', '/');
---
<Base>
  <p class="lead">世界モデルの論文を読んで、考えて、作る記録。</p>

  <div class="stats">
    {stats.map((s) => (
      <div class="card stat">
        <div class="v">{s.value}<small>{s.unit}</small></div>
        <div class="muted">{s.label}</div>
      </div>
    ))}
  </div>

  <div class="two">
    <section>
      <h2>いま読んでいる</h2>
      {reading.length === 0 && <p class="muted">なし</p>}
      {reading.map((p) => {
        const pr = progress(p);
        const next = p.data.steps.find((s) => !s.done);
        return (
          <a class="card now" href={url(`/papers/${p.id}/`)}>
            <b>{p.data.title}</b>
            {pr.total > 0 ? (
              <>
                <div class="bar"><span style={`width:${pr.ratio * 100}%`} /></div>
                <div class="muted">{pr.done} / {pr.total} ステップ{next && <> · 次: {next.name}</>}</div>
              </>
            ) : <div class="muted">ステップ未設定</div>}
          </a>
        );
      })}
      {trying.length > 0 && (
        <>
          <h2>着手中の try</h2>
          {trying.map((t) => (
            <a class="card now" href={url('/try/')}>
              <b>{t.data.title}</b>
              {t.data.why && <div class="muted">{t.data.why}</div>}
            </a>
          ))}
        </>
      )}
    </section>
    <section>
      <h2>積み上げ <span class="muted sub">直近90日の成果の合計</span></h2>
      <div class="card"><ActivityCurve acts={acts} /></div>
    </section>
  </div>

  <h2>成果ログ</h2>
  <ul class="card log">
    {acts.slice(0, 8).map((a) => (
      <li><span class="d">{fmt(a.date)}</span><span class:list={['k', `k-${a.kind}`]}>{a.kind}</span><a href={a.href}>{a.title}</a></li>
    ))}
  </ul>

  <h2>最近の考察</h2>
  {notes(papers).slice(0, 3).map((n) => <NoteCard {...n} />)}

  <h2>Denoise <span class="sub muted">— どぱ抜き</span></h2>
  <p class="muted small">ノイズから解放される浮島。ドラッグで回してホイールで寄れる。読了した論文が増えると結晶が増え、♡ を押すと好みの地形を覚えて似た地形が出やすくなる。⚙ でノイズと太陽の気分を調整できる。</p>
  <World read={done.length} />
</Base>
<style>
  .lead { color: var(--muted); margin: 0 0 16px; }
  .small { font-size: .85rem; margin-top: -4px; }
  .sub { font-size: .8rem; font-weight: 400; margin-left: 6px; }
  .stats { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .stat .v { font-size: 2rem; font-weight: 700; line-height: 1.1; }
  .stat small { font-size: .9rem; margin-left: 4px; color: var(--muted); }
  .two { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
  .now { display: block; color: var(--ink); text-decoration: none; margin-bottom: 8px; }
  .now:hover { border-color: var(--accent); }
  .now .bar { margin: 8px 0 4px; }
  .log { list-style: none; margin: 0; padding: 8px 16px; }
  .log li { display: flex; gap: 10px; align-items: baseline; padding: 6px 0; border-bottom: 1px dotted var(--line); }
  .log li:last-child { border: 0; }
  .log .d { font-family: var(--mono); color: var(--muted); font-size: .8rem; }
  .log .k { font-size: .72rem; padding: 0 6px; border-radius: 4px; border: 1px solid currentColor; white-space: nowrap; }
  .k-読了 { color: var(--good); } .k-考察 { color: var(--accent); } .k-実験 { color: var(--accent2); } .k-ステップ { color: var(--muted); } .k-解説 { color: var(--accent); } .k-try { color: var(--good); }
  .log a { color: var(--ink); text-decoration: none; }
  .log a:hover { color: var(--accent); }
</style>
